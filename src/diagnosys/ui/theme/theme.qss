QWidget {
    color: @text@;
    font-family: "Segoe UI";
    font-size: 13px;
}

QMainWindow, QDialog { background: @background@; }
QWidget#AppShell { background: @background@; }
QWidget#DashboardPage { background: transparent; }
QFrame#Sidebar {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: @radius_large@;
}
QFrame#MetricCard, QFrame#Panel, QFrame#SummaryCard {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: @radius_medium@;
}
QFrame#MetricCard:hover, QFrame#SummaryCard:hover {
    background: @surface_raised@;
    border-color: #33443A;
}
QFrame#InsetPanel {
    background: @surface_raised@;
    border: 1px solid @border@;
    border-radius: @radius_small@;
}

QLabel#Brand { color: @text@; font-size: 21px; font-weight: 700; letter-spacing: 0.2px; }
QLabel#BrandMark { color: @accent@; font-size: 20px; font-weight: 700; }
QLabel#PageTitle { color: @text@; font-size: 25px; font-weight: 700; }
QLabel#SectionTitle { color: @text@; font-size: 15px; font-weight: 650; }
QLabel#Muted, QLabel#Subtitle { color: @secondary@; }
QLabel#TinyLabel { color: @muted@; font-size: 11px; font-weight: 600; }
QLabel#MetricName { color: @secondary@; font-size: 12px; font-weight: 600; }
QLabel#MetricValue { color: @text@; font-size: 24px; font-weight: 700; }
QLabel#SummaryValue { color: @text@; font-size: 16px; font-weight: 650; }
QLabel#MetricDetail { color: @secondary@; font-size: 12px; }
QLabel#AccentText { color: @accent@; font-weight: 650; }
QLabel#WarningText { color: @warning@; font-weight: 600; }
QLabel#ErrorText { color: @error@; font-weight: 600; }
QLabel#StatusPill, QLabel#PillGood, QLabel#PillWarning, QLabel#PillError, QLabel#PillNeutral {
    border-radius: 9px;
    padding: 5px 9px;
    font-size: 11px;
    font-weight: 650;
}
QLabel#PillGood { color: @accent@; background: @accent_dim@; }
QLabel#PillWarning { color: @warning@; background: #382C18; }
QLabel#PillError { color: @error@; background: #3B2021; }
QLabel#PillNeutral { color: @secondary@; background: @surface_raised@; }

QPushButton {
    background: @surface_raised@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: @radius_small@;
    padding: 9px 13px;
    font-weight: 600;
}
QPushButton:hover { background: @surface_hover@; border-color: #38493E; }
QPushButton:pressed { background: #202B24; }
QPushButton:disabled { color: @muted@; background: @surface@; }
QPushButton:focus, QLineEdit:focus { border-color: @accent@; }
QPushButton#PrimaryButton { background: @accent@; color: #08120B; border: none; }
QPushButton#PrimaryButton:hover { background: @accent_hover@; }
QPushButton#PrimaryButton:pressed { background: #2DBE75; }
QPushButton#NavButton {
    text-align: left;
    color: @secondary@;
    background: transparent;
    border: 1px solid transparent;
    padding: 11px 12px;
    font-weight: 550;
}
QPushButton#NavButton:hover { color: @text@; background: @surface_raised@; }
QPushButton#NavButton:checked {
    color: @accent@;
    background: @accent_dim@;
    border-color: #234A35;
}
QPushButton#SymptomChoice {
    text-align: left;
    background: @surface_raised@;
    border-color: @border@;
    color: @text@;
    padding: 10px 12px;
}
QPushButton#SymptomChoice:hover { border-color: @accent@; }
QPushButton#SymptomChoice:checked {
    color: @accent@;
    background: @accent_dim@;
    border-color: @accent@;
}
QPushButton#QuietButton { background: transparent; border-color: transparent; color: @secondary@; }

QLineEdit, QComboBox, QTextEdit, QPlainTextEdit, QTableWidget {
    background: @surface_raised@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: @radius_small@;
    padding: 8px 10px;
    selection-background-color: @accent_dim@;
}
QTextEdit, QPlainTextEdit { padding: 12px; }
QTextEdit:focus, QPlainTextEdit:focus, QLineEdit:focus { border-color: @accent@; }
QProgressBar {
    background: #202A23;
    border: none;
    border-radius: 4px;
    height: 7px;
}
QProgressBar::chunk { background: @accent@; border-radius: 4px; }
QProgressBar[tone="warning"]::chunk { background: @warning@; }
QProgressBar[tone="critical"]::chunk { background: @error@; }

QTableWidget { gridline-color: @border@; alternate-background-color: @surface_raised@; padding: 2px; }
QTableWidget::item { padding: 7px 8px; border: none; }
QTableWidget::item:selected { background: @accent_dim@; color: @text@; }
QHeaderView::section {
    background: @surface_raised@;
    color: @secondary@;
    border: none;
    border-bottom: 1px solid @border@;
    padding: 8px;
    font-size: 11px;
    font-weight: 650;
}
QScrollArea { border: none; background: transparent; }
QAbstractScrollArea::viewport { background: transparent; }
QScrollBar:vertical { background: transparent; width: 9px; margin: 2px; }
QScrollBar::handle:vertical { background: #344238; border-radius: 4px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #46584B; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QToolTip { color: @text@; background: @surface_hover@; border: 1px solid @border@; padding: 5px 8px; }
